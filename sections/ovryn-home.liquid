{% comment %}
  OVRYN — COMPLETE SHOPIFY HOMEPAGE
  Dark / Premium / Futuristic Streetwear
  Navigation-safe version
{% endcomment %}

{% assign tees_collection = section.settings.tees_collection %}
{% assign featured_collection = section.settings.featured_collection %}

{% if tees_collection != blank %}
  {% assign shop_collection_url = tees_collection.url %}
{% elsif featured_collection != blank %}
  {% assign shop_collection_url = featured_collection.url %}
{% else %}
  {% assign shop_collection_url = routes.all_products_collection_url %}
{% endif %}

<div id="ovryn-{{ section.id }}" class="ovryn-site">

  <!-- ================= HEADER ================= -->

  <header class="ovryn-header">

    <a href="{{ routes.root_url }}" class="ovryn-logo">
      OVRYN
    </a>

    <nav class="ovryn-nav">
      <a href="{{ shop_collection_url }}">SHOP</a>

      <a href="{% if tees_collection != blank %}{{ tees_collection.url }}{% else %}{{ shop_collection_url }}{% endif %}">
        TEES
      </a>

      {% if section.settings.about_page != blank %}
        <a href="{{ section.settings.about_page }}">ABOUT</a>
      {% else %}
        <a href="{{ routes.root_url }}#about">ABOUT</a>
      {% endif %}
    </nav>

    <div class="ovryn-actions">

      <a href="{{ routes.search_url }}" class="ovryn-search" aria-label="Search">
        <svg viewBox="0 0 24 24">
          <circle cx="10.8" cy="10.8" r="6.5"></circle>
          <path d="M15.7 15.7L21 21"></path>
        </svg>
      </a>

      <a href="{{ routes.cart_url }}" class="ovryn-cart">
        CART <sup>{{ cart.item_count }}</sup>
      </a>

      <button class="ovryn-menu-open" type="button" aria-label="Open menu">
        <span></span>
        <span></span>
      </button>

    </div>

  </header>


  <!-- ================= MOBILE MENU ================= -->

  <div class="ovryn-mobile-menu">

    <div class="ovryn-mobile-top">
      <span>OVRYN / MENU</span>
      <button type="button" class="ovryn-menu-close">CLOSE</button>
    </div>

    <nav class="ovryn-mobile-links">

      <a href="{{ shop_collection_url }}">
        <small>01</small>
        SHOP
      </a>

      <a href="{% if tees_collection != blank %}{{ tees_collection.url }}{% else %}{{ shop_collection_url }}{% endif %}">
        <small>02</small>
        TEES
      </a>

      {% if section.settings.about_page != blank %}
        <a href="{{ section.settings.about_page }}">
          <small>03</small>
          ABOUT
        </a>
      {% else %}
        <a href="{{ routes.root_url }}#about">
          <small>03</small>
          ABOUT
        </a>
      {% endif %}

      <a href="{{ routes.search_url }}">
        <small>04</small>
        SEARCH
      </a>

      <a href="{{ routes.cart_url }}">
        <small>05</small>
        CART
      </a>

    </nav>

    <div class="ovryn-mobile-bottom">
      {{ section.settings.tagline }}
    </div>

  </div>


  <!-- ================= HERO ================= -->

  <section class="ovryn-hero">

    {% if section.settings.hero_image != blank %}

      <img
        class="ovryn-hero-image"
        src="{{ section.settings.hero_image | image_url: width: 2400 }}"
        srcset="
          {{ section.settings.hero_image | image_url: width: 750 }} 750w,
          {{ section.settings.hero_image | image_url: width: 1200 }} 1200w,
          {{ section.settings.hero_image | image_url: width: 1800 }} 1800w,
          {{ section.settings.hero_image | image_url: width: 2400 }} 2400w
        "
        sizes="100vw"
        width="{{ section.settings.hero_image.width }}"
        height="{{ section.settings.hero_image.height }}"
        alt="{{ section.settings.hero_image.alt | escape }}"
        loading="eager"
        fetchpriority="high"
      >

    {% else %}

      <div class="ovryn-placeholder">
        UPLOAD HERO IMAGE
      </div>

    {% endif %}

    <div class="ovryn-hero-overlay"></div>

    <div class="ovryn-hero-content">

      <div class="ovryn-hero-meta">
        <span>OVRYN / EST. 2026</span>
        <span>{{ section.settings.tagline }}</span>
        <span>NOT FOR EVERYONE.</span>
      </div>

      <div class="ovryn-hero-center">

        <div class="ovryn-kicker">
          NOT FOR EVERYONE.
        </div>

        <h1>
          UNFOLLOW
          <em>THE MID.</em>
        </h1>

        <a href="{% if featured_collection != blank %}{{ featured_collection.url }}{% else %}{{ shop_collection_url }}{% endif %}" class="ovryn-button">
          <span>{{ section.settings.hero_button_text }}</span>
          <span>↗</span>
        </a>

      </div>

      <div class="ovryn-scroll">
        SCROLL TO EXPLORE
        <i></i>
      </div>

    </div>

  </section>


  <!-- ================= MARQUEE ================= -->

  <section class="ovryn-marquee">

    <div class="ovryn-marquee-track">
      <span>OVRYN</span>
      <b>✦</b>
      <span>UNFOLLOWING THE MID.</span>
      <b>✦</b>
      <span>OVRYN</span>
      <b>✦</b>
      <span>UNFOLLOWING THE MID.</span>
      <b>✦</b>
      <span>OVRYN</span>
      <b>✦</b>
      <span>UNFOLLOWING THE MID.</span>
      <b>✦</b>
      <span>OVRYN</span>
      <b>✦</b>
      <span>UNFOLLOWING THE MID.</span>
      <b>✦</b>
    </div>

  </section>


  <!-- ================= ABOUT / INTRO ================= -->

  <section id="about" class="ovryn-intro ovryn-reveal">

    <div class="ovryn-number">
      01 / IDENTITY
    </div>

    <div class="ovryn-intro-content">

      <div class="ovryn-label">
        THE BRAND
      </div>

      <h2>
        ORDINARY<br>
        <em>IS NOT</em><br>
        THE GOAL.
      </h2>

      <div class="ovryn-intro-bottom">

        <p>
          OVRYN exists outside the algorithm.
          Designed for those who refuse to blend
          into the middle.
        </p>

        {% if section.settings.about_page != blank %}

          <a href="{{ section.settings.about_page }}">
            DISCOVER OVRYN ↗
          </a>

        {% else %}

          <a href="#about">
            DISCOVER OVRYN ↗
          </a>

        {% endif %}

      </div>

    </div>

  </section>


  <!-- ================= FEATURED COLLECTION ================= -->

  <section class="ovryn-products ovryn-reveal">

    <div class="ovryn-section-header">

      <div>
        <span>02 / THE DROP</span>
        <h2>THE DROP.</h2>
      </div>

      {% if featured_collection != blank %}

        <a href="{{ featured_collection.url }}">
          VIEW ALL ↗
        </a>

      {% endif %}

    </div>


    {% if featured_collection != blank and featured_collection.products_count > 0 %}

      <div class="ovryn-product-grid">

        {% for product in featured_collection.products limit: section.settings.product_limit %}

          <article class="ovryn-product-card">

            <a
              href="{{ product.url }}"
              class="ovryn-product-image-wrap"
              aria-label="{{ product.title | escape }}"
            >

              {% if product.featured_image != blank %}

                <img
                  class="ovryn-product-image ovryn-main-image"
                  src="{{ product.featured_image | image_url: width: 1000 }}"
                  width="{{ product.featured_image.width }}"
                  height="{{ product.featured_image.height }}"
                  alt="{{ product.featured_image.alt | default: product.title | escape }}"
                  loading="lazy"
                >

                {% if product.images.size > 1 %}

                  <img
                    class="ovryn-product-image ovryn-hover-image"
                    src="{{ product.images[1] | image_url: width: 1000 }}"
                    width="{{ product.images[1].width }}"
                    height="{{ product.images[1].height }}"
                    alt="{{ product.title | escape }}"
                    loading="lazy"
                  >

                {% endif %}

              {% else %}

                <div class="ovryn-product-placeholder">
                  OVRYN
                </div>

              {% endif %}

              <span class="ovryn-view-product">
                VIEW PRODUCT ↗
              </span>

            </a>


            <div class="ovryn-product-info">

              <div>

                <h3>
                  {{ product.title }}
                </h3>

                {% if product.available %}

                  <p class="ovryn-available">AVAILABLE NOW</p>

                {% else %}

                  <p>SOLD OUT</p>

                {% endif %}

              </div>

              <strong>
                {{ product.price | money }}
              </strong>

            </div>

          </article>

        {% endfor %}

      </div>

    {% else %}

      <div class="ovryn-empty">

        <strong>THE DROP</strong>

        <p>
          Select your T-shirt collection in the Theme Editor.
        </p>

      </div>

    {% endif %}

  </section>


  <!-- ================= STATEMENT ================= -->

  <section class="ovryn-statement ovryn-reveal">

    <div class="ovryn-statement-bg"></div>

    <div class="ovryn-statement-content">

      <div class="ovryn-label">
        03 / MINDSET
      </div>

      <h2>
        UNFOLLOW<br>
        <em>THE MID.</em>
      </h2>

      <div class="ovryn-statement-footer">
        <span>OVRYN</span>
        <span>THERE IS NO MIDDLE.</span>
        <span>2026</span>
      </div>

    </div>

  </section>


  <!-- ================= TEES ================= -->

  <section class="ovryn-tees ovryn-reveal">

    <div class="ovryn-section-header">

      <div>
        <span>04 / COLLECTION</span>
        <h2>TEES.</h2>
      </div>

      <a href="{% if tees_collection != blank %}{{ tees_collection.url }}{% else %}{{ shop_collection_url }}{% endif %}">
        SHOP TEES ↗
      </a>

    </div>


    <a
      href="{% if tees_collection != blank %}{{ tees_collection.url }}{% else %}{{ shop_collection_url }}{% endif %}"
      class="ovryn-tees-image"
    >

      {% if section.settings.tees_image != blank %}

        <img
          src="{{ section.settings.tees_image | image_url: width: 2200 }}"
          srcset="
            {{ section.settings.tees_image | image_url: width: 750 }} 750w,
            {{ section.settings.tees_image | image_url: width: 1200 }} 1200w,
            {{ section.settings.tees_image | image_url: width: 1800 }} 1800w,
            {{ section.settings.tees_image | image_url: width: 2200 }} 2200w
          "
          sizes="100vw"
          width="{{ section.settings.tees_image.width }}"
          height="{{ section.settings.tees_image.height }}"
          alt="OVRYN T-shirts"
          loading="lazy"
        >

      {% else %}

        <div class="ovryn-tees-placeholder">
          <span>OVRYN</span>
          <small>UPLOAD TEES IMAGE</small>
        </div>

      {% endif %}

      <div class="ovryn-tees-overlay"></div>

      <div class="ovryn-tees-center">
        <span>SHOP THE COLLECTION</span>
        <strong>TEES ↗</strong>
      </div>

    </a>

  </section>


  <!-- ================= NEWSLETTER ================= -->

  <section class="ovryn-newsletter ovryn-reveal">

    <div class="ovryn-newsletter-top">
      <span>05 / ACCESS</span>
      <span>NO SPAM. JUST OVRYN.</span>
    </div>

    <div class="ovryn-newsletter-main">

      <div class="ovryn-label">
        JOIN THE OUTSIDERS.
      </div>

      <h2>
        STAY<br>
        <em>UNFOLLOWED.</em>
      </h2>

      {% form 'customer', class: 'ovryn-newsletter-form' %}

        <input
          type="hidden"
          name="contact[tags]"
          value="newsletter"
        >

        <label for="ovryn-email-{{ section.id }}">
          EMAIL ADDRESS
        </label>

        <div class="ovryn-email-row">

          <input
            id="ovryn-email-{{ section.id }}"
            type="email"
            name="contact[email]"
            placeholder="YOUR EMAIL"
            autocomplete="email"
            required
          >

          <button type="submit">
            SUBSCRIBE ↗
          </button>

        </div>

        {% if form.posted_successfully? %}
          <p class="ovryn-success">
            YOU'RE IN.
          </p>
        {% endif %}

        {% if form.errors %}
          <div class="ovryn-error">
            {{ form.errors | default_errors }}
          </div>
        {% endif %}

      {% endform %}

      <p class="ovryn-newsletter-note">
        EARLY ACCESS / NEW DROPS / NOTHING ORDINARY
      </p>

    </div>

  </section>


  <!-- ================= FOOTER ================= -->

  <footer class="ovryn-footer">

    <div class="ovryn-footer-brand-row">

      <div class="ovryn-footer-brand">
        OVRYN
      </div>

      <p>
        {{ section.settings.tagline }}
      </p>

    </div>


    <div class="ovryn-footer-grid">

      <div class="ovryn-footer-column">

        <span>SHOP</span>

        <a href="{{ shop_collection_url }}">
          ALL TEES
        </a>

        <a href="{% if tees_collection != blank %}{{ tees_collection.url }}{% else %}{{ shop_collection_url }}{% endif %}">
          TEES
        </a>

        {% if featured_collection != blank %}

          <a href="{{ featured_collection.url }}">
            THE DROP
          </a>

        {% endif %}

      </div>


      <div class="ovryn-footer-column">

        <span>INFO</span>

        {% if section.settings.about_page != blank %}
          <a href="{{ section.settings.about_page }}">
            ABOUT
          </a>
        {% endif %}

        {% if section.settings.contact_page != blank %}
          <a href="{{ section.settings.contact_page }}">
            CONTACT
          </a>
        {% endif %}

        {% if section.settings.shipping_policy != blank %}
          <a href="{{ section.settings.shipping_policy }}">
            SHIPPING
          </a>
        {% endif %}

        {% if section.settings.returns_page != blank %}
          <a href="{{ section.settings.returns_page }}">
            RETURNS &amp; EXCHANGES
          </a>
        {% endif %}

      </div>


      <div class="ovryn-footer-column">

        <span>FOLLOW</span>

        {% if section.settings.instagram_url != blank %}

          <a
            href="{{ section.settings.instagram_url }}"
            target="_blank"
            rel="noopener noreferrer"
          >
            INSTAGRAM ↗
          </a>

        {% endif %}

        {% if section.settings.tiktok_url != blank %}

          <a
            href="{{ section.settings.tiktok_url }}"
            target="_blank"
            rel="noopener noreferrer"
          >
            TIKTOK ↗
          </a>

        {% endif %}

      </div>


      <div class="ovryn-footer-column">

        <span>CONTACT</span>

        {% if section.settings.contact_email != blank %}

          <a href="mailto:{{ section.settings.contact_email }}">
            {{ section.settings.contact_email }}
          </a>

        {% endif %}

        <a href="{{ routes.cart_url }}">
          CART / {{ cart.item_count }}
        </a>

      </div>

    </div>


    <div class="ovryn-footer-bottom">

      <span>
        © {{ 'now' | date: '%Y' }} OVRYN
      </span>

      <span>
        {{ section.settings.tagline }}
      </span>

      {% if section.settings.privacy_policy != blank %}
        <a href="{{ section.settings.privacy_policy }}">
          PRIVACY
        </a>
      {% endif %}

      {% if section.settings.terms_policy != blank %}
        <a href="{{ section.settings.terms_policy }}">
          TERMS
        </a>
      {% endif %}

    </div>

  </footer>

</div>


<style>

#ovryn-{{ section.id }} {
  --black:#050505;
  --white:#f4f4f0;
  --grey:#777;
  --border:rgba(255,255,255,.13);
  --hazel:#a9762f;
  --hazel-light:#d6ab63;

  width:100%;
  max-width:100%;
  overflow:hidden;

  background:var(--black);
  color:var(--white);

  font-family:Arial,Helvetica,sans-serif;

  -webkit-font-smoothing:antialiased;
}

#ovryn-{{ section.id }} *,
#ovryn-{{ section.id }} *::before,
#ovryn-{{ section.id }} *::after {
  box-sizing:border-box;
}

#ovryn-{{ section.id }} a {
  color:inherit;
  text-decoration:none;
}

#ovryn-{{ section.id }} button,
#ovryn-{{ section.id }} input {
  font:inherit;
}


/* HEADER */

#ovryn-{{ section.id }} .ovryn-header {
  position:absolute;
  top:0;
  left:0;
  z-index:50;

  width:100%;
  height:82px;

  display:grid;
  grid-template-columns:1fr auto 1fr;
  align-items:center;

  padding:0 28px;

  border-bottom:1px solid rgba(255,255,255,.12);

  background:linear-gradient(
    to bottom,
    rgba(0,0,0,.5),
    transparent
  );
}

#ovryn-{{ section.id }} .ovryn-logo {
  font-size:27px;
  font-weight:900;
  letter-spacing:-.09em;
}

#ovryn-{{ section.id }} .ovryn-nav {
  display:flex;
  gap:34px;
}

#ovryn-{{ section.id }} .ovryn-nav a,
#ovryn-{{ section.id }} .ovryn-cart,
#ovryn-{{ section.id }} .ovryn-search {
  font-size:10px;
  font-weight:700;
  letter-spacing:.17em;
  transition:color .25s ease;
}

#ovryn-{{ section.id }} .ovryn-nav a:hover,
#ovryn-{{ section.id }} .ovryn-cart:hover,
#ovryn-{{ section.id }} .ovryn-search:hover {
  color:var(--hazel-light);
}

#ovryn-{{ section.id }} .ovryn-actions {
  justify-self:end;

  display:flex;
  align-items:center;
  gap:20px;
}

#ovryn-{{ section.id }} .ovryn-search svg {
  width:18px;
  height:18px;

  fill:none;
  stroke:currentColor;
  stroke-width:1.4;
}

#ovryn-{{ section.id }} .ovryn-cart sup {
  position:relative;
  top:-4px;
  font-size:8px;
}

#ovryn-{{ section.id }} .ovryn-menu-open {
  display:none;

  width:40px;
  height:40px;

  padding:0;
  border:0;

  background:transparent;
}

#ovryn-{{ section.id }} .ovryn-menu-open span {
  display:block;

  width:19px;
  height:1px;

  margin:5px auto;

  background:#fff;
}


/* MOBILE MENU */

#ovryn-{{ section.id }} .ovryn-mobile-menu {
  position:fixed;
  inset:0;

  z-index:999;

  display:flex;
  flex-direction:column;
  justify-content:space-between;

  padding:28px;

  background:#050505;

  opacity:0;
  visibility:hidden;

  transform:translateY(-15px);

  transition:
    opacity .35s ease,
    visibility .35s ease,
    transform .35s ease;
}

#ovryn-{{ section.id }} .ovryn-mobile-menu.is-open {
  opacity:1;
  visibility:visible;
  transform:translateY(0);
}

#ovryn-{{ section.id }} .ovryn-mobile-top {
  display:flex;
  justify-content:space-between;

  font-size:9px;
  letter-spacing:.18em;
}

#ovryn-{{ section.id }} .ovryn-menu-close {
  border:0;
  background:none;
  color:#fff;

  font-size:9px;
  letter-spacing:.15em;
}

#ovryn-{{ section.id }} .ovryn-mobile-links {
  display:flex;
  flex-direction:column;
}

#ovryn-{{ section.id }} .ovryn-mobile-links a {
  display:flex;
  align-items:baseline;
  gap:12px;

  padding:14px 0;

  border-bottom:1px solid var(--border);

  font-size:clamp(48px,15vw,90px);
  line-height:.82;

  letter-spacing:-.08em;
}

#ovryn-{{ section.id }} .ovryn-mobile-links small {
  color:var(--hazel-light);
  font-size:8px;
  letter-spacing:.1em;
}

#ovryn-{{ section.id }} .ovryn-mobile-links a:active {
  color:var(--hazel-light);
}

#ovryn-{{ section.id }} .ovryn-mobile-bottom {
  color:#999;

  font-size:9px;
  letter-spacing:.17em;
}


/* HERO */

#ovryn-{{ section.id }} .ovryn-hero {
  position:relative;

  width:100%;
  height:100vh;
  min-height:680px;

  overflow:hidden;

  background:#080808;
}

#ovryn-{{ section.id }} .ovryn-hero-image {
  position:absolute;
  inset:0;

  width:100%;
  height:100%;

  object-fit:cover;

  filter:
    brightness(.45)
    contrast(1.1)
    saturate(.65);

  transform:scale(1.04);

  animation:ovrynZoom 14s ease-out forwards;
}

@keyframes ovrynZoom {
  from { transform:scale(1.08); }
  to { transform:scale(1); }
}

#ovryn-{{ section.id }} .ovryn-placeholder {
  position:absolute;
  inset:0;

  display:flex;
  align-items:center;
  justify-content:center;

  background:#101010;

  color:#999;

  font-size:10px;
  letter-spacing:.2em;
}

#ovryn-{{ section.id }} .ovryn-hero-overlay {
  position:absolute;
  inset:0;

  background:
    linear-gradient(
      to bottom,
      rgba(0,0,0,.6),
      rgba(0,0,0,.05) 40%,
      rgba(0,0,0,.8)
    );
}

#ovryn-{{ section.id }} .ovryn-hero-content {
  position:relative;
  z-index:2;

  width:100%;
  height:100%;

  display:flex;
  flex-direction:column;
  justify-content:space-between;

  padding:115px 38px 28px;
}

#ovryn-{{ section.id }} .ovryn-hero-meta {
  display:grid;
  grid-template-columns:1fr 1fr 1fr;

  font-size:9px;
  font-weight:700;
  letter-spacing:.18em;
}

#ovryn-{{ section.id }} .ovryn-hero-meta:nth-child(2) {
  text-align:center;
}

#ovryn-{{ section.id }} .ovryn-hero-meta span:nth-child(2) {
  text-align:center;
}

#ovryn-{{ section.id }} .ovryn-hero-meta span:last-child {
  text-align:right;
}

#ovryn-{{ section.id }} .ovryn-hero-center {
  text-align:center;
}

#ovryn-{{ section.id }} .ovryn-kicker {
  margin-bottom:22px;

  font-size:10px;
  font-weight:700;
  letter-spacing:.3em;
}

#ovryn-{{ section.id }} .ovryn-hero h1 {
  margin:0;

  font-size:clamp(100px,13.8vw,225px);

  font-weight:900;
  line-height:.72;

  letter-spacing:-.095em;
}

#ovryn-{{ section.id }} .ovryn-hero h1 em {
  display:block;

  color:transparent;

  font-style:normal;

  -webkit-text-stroke:1.2px rgba(169,118,47,.95);
}

#ovryn-{{ section.id }} .ovryn-button {
  display:inline-flex;
  align-items:center;
  justify-content:space-between;

  gap:50px;

  min-width:220px;
  height:54px;

  margin-top:48px;
  padding:0 18px;

  border:1px solid rgba(169,118,47,.7);

  font-size:11px;
  font-weight:700;
  letter-spacing:.17em;

  transition:
    background .3s ease,
    color .3s ease,
    border-color .3s ease,
    transform .3s ease;
}

#ovryn-{{ section.id }} .ovryn-button:hover {
  background:var(--hazel);
  border-color:var(--hazel);
  color:var(--black);
  transform:translateY(-3px);
}

#ovryn-{{ section.id }} .ovryn-scroll {
  display:flex;
  align-items:center;
  justify-content:center;

  gap:13px;

  font-size:8px;
  letter-spacing:.18em;
}

#ovryn-{{ section.id }} .ovryn-scroll i {
  display:block;

  width:1px;
  height:42px;

