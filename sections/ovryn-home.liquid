          entry.target.classList.add('ovryn-visible');

          observer.unobserve(entry.target);

        }

      });

    }, {
      threshold:0.08
    });

    reveals.forEach(function(element) {

      observer.observe(element);

      /* Safety net: guarantee the section becomes visible even if this
         browser's IntersectionObserver never reports an intersection
         (seen in some embedded/sandboxed preview contexts), so content
         can never stay permanently hidden. */
      setTimeout(function() {

        element.classList.add('ovryn-visible');

        observer.unobserve(element);

      }, 1200);

    });

  } else {

    reveals.forEach(function(element) {

      element.classList.add('ovryn-visible');

    });

  }

})();

</script>


